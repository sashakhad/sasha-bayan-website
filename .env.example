# OpenAI API Key for newsletter content generation
OPENAI_API_KEY=your_openai_api_key_here

# Resend API configuration for email delivery
RESEND_API_KEY=your_resend_api_key_here
RESEND_AUDIENCE_ID=your_resend_audience_id_here

# Newsletter from email (optional, defaults to shows@sashabayan.com)
NEWSLETTER_FROM_EMAIL=shows@sashabayan.com

# Cron job authentication secret
CRON_SECRET=your_secure_cron_secret_here

# Upstash Redis configuration (optional, will fallback to filesystem)
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Base URL for the website (used in email links)
NEXT_PUBLIC_BASE_URL=https://sashabayan.com
